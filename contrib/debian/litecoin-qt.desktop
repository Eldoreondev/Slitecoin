[Desktop Entry]
Version=1.0
Name=SLiteCoin Core
Comment=Connect to the SLiteCoin P2P Network
Comment[de]=Verbindung mit dem SLiteCoin Peer-to-Peer-Netzwerk herstellen
Comment[es]=Conectar a la red P2P de SLiteCoin
Comment[fr]=Se connecter au réseau pair à pair SLiteCoin
GenericName=Cryptocurrency Wallet
Exec=slitecoin-qt %u
Terminal=false
Type=Application
Icon=slitecoin128
MimeType=x-scheme-handler/slitecoin;
Categories=Office;Finance;Network;
Keywords=slitecoin;crypto;cryptocurrency;wallet;blockchain;
StartupNotify=true
StartupWMClass=SLitecoin-qt
